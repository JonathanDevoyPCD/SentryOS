# Frontend-safe configuration only. Never place an AI provider key in VITE_* variables.
VITE_SENTRY_API_MODE=mock
VITE_SENTRY_API_BASE=/api/v1

# These values are read only by `npm run bridge`; do not expose them as VITE_* variables.
# Copy this file to .env.local before adding real router credentials.
SENTRY_ROUTER_URL=http://192.168.0.1
SENTRY_ROUTER_USERNAME=admin
SENTRY_ROUTER_PASSWORD=
